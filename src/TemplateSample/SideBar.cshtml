@using RazorLight
@using BlogGenerator.Models
@inherits TemplatePage<SideBarModel>
@{
    var model = Model;
}
<aside>
    <div class="has-text-centered"></div>
</aside>
<aside class="mt-5">
    <div class="has-text-centered">
        <img src="@Model.GeneratePath("/img/icon.png")" width="100px" height="100px" loading="lazy">
        <h1 class="title is-5">@Model.SiteOption.SiteAuthor</h1>
    </div>
    <div class="content mb-3"><p class="mt-5">@Model.SiteOption.SiteAuthorDescription</p></div>
</aside>
<aside class="mt-5">
    <h1 class="title is-5">Recent</h1>
    <nav class="panel panel-white">
        @foreach (var post in model.Articles.Take(10))
        {
            <a class="panel-block" href="@post.RootRelativePath"><span class="panel-icon"><i class="fas fa-book" aria-hidden="true"></i></span>@post.Title</a>
        }
    </nav>
</aside>
<aside class="mt-5">
    <h1 class="title is-5">Tags</h1>
    <nav class="panel panel-white">
        @foreach (var tag in Model.TagCatalog.Entries.OrderByDescending(tag => tag.Count).ThenBy(tag => tag.DisplayName).Take(10))
        {
            <a class="panel-block" href="@Model.GenerateTagPath(tag.DisplayName)"><span class="panel-icon"><i class="fas fa-book" aria-hidden="true"></i></span><span>@tag.DisplayName (@tag.Count)</span></a>
        }
    </nav>
</aside>
<aside class="mt-5">
    <h1 class="title is-5">Archive</h1>
    <nav class="panel panel-white">
        @{
            var yearMonthCount = model.Articles
                .Where(x => x.Published.HasValue)
                .GroupBy(x => new { Year = x.Published!.Value.Year, Month = x.Published!.Value.Month })
                .Select(group => new { Year = group.Key.Year, Month = group.Key.Month, Count = group.Count() })
                .ToArray();
        }
        @foreach (var g in yearMonthCount)
        {
            <a class="panel-block" href="@Model.GeneratePath($"/{g.Year}/{g.Month.ToString("D2")}")"><span class="panel-icon"><i class="fas fa-book" aria-hidden="true"></i></span><span>@($"{g.Year}-{g.Month.ToString("D2")}") (@g.Count)</span></a>
        }
    </nav>
</aside>
<aside class="mt-5 ml-2">
  <ul>
    <li><a href="@Model.GeneratePath("/feed.rss")"><i class="fa fa-rss"></i>RSS Feed</a></li>
    <li><a href="@Model.GeneratePath("/feed.atom")"><i class="fa fa-rss"></i>Atom Feed</a></li>
  </ul>
</aside>
