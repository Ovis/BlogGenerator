<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>bloggen</ToolCommandName>
		<PackageId>eSheepDev.BlogGenerator</PackageId>
		<Version>0.0.1.0</Version>
		<PackageOutputPath>./nupkg</PackageOutputPath>
		<PackageReadmeFile>./README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl></RepositoryUrl>
		<PackageProjectUrl>https://github.com/Ovis/BlogGenerator</PackageProjectUrl>
		<Copyright>© 2025 Ovis</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.7.1" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
		<PackageReference Include="RazorLight" Version="2.3.1" />
		<PackageReference Include="ReadJEnc" Version="1.3.1.2" />
		<PackageReference Include="System.CommandLine" Version="2.0.11" />
		<PackageReference Include="System.ServiceModel.Syndication" Version="10.0.11" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\Embeds\Amazon.cshtml" />
		<None Update="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Templates\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\README.md" Pack="true" PackagePath="\">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
